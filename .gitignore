########################
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db

########################
# IDE - IntelliJ IDEA
########################
.idea/
*.iml
*.ipr
*.iws
out/

########################
# IDE - VS Code
########################
.vscode/
.history/

########################
# Logs
########################
*.log
logs/
**/logs/

########################
# ===== Frontend (React) =====
########################
# Node dependencies
frontend/node_modules/

# Build outputs
frontend/build/
frontend/dist/

# Env files (DO NOT COMMIT)
frontend/.env
frontend/.env.*
!frontend/.env.example

########################
# ===== Backend (Spring Boot) =====
########################
# Maven / Gradle
backend/target/

# Eclipse (if ever opened)
backend/.classpath
backend/.project
backend/.settings/

# Spring Boot logs
backend/logs/
backend/*.log

# Application config (local / secrets)
backend/src/main/resources/application-local.properties
backend/src/main/resources/application-*.properties
!backend/src/main/resources/application.properties
backend/.env

########################
# ===== Others =====
########################
# Temporary files
*.tmp
*.swp
*.swo


# env files
.env
.env.*

